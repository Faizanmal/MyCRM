# ==============================================================================
# MyCRM Root Environment Configuration (Example)
# ==============================================================================
# This file contains the root environment variables used by Docker Compose
# and core orchestration, including configurations tailored FOR PRODUCTION DOCKER.
#
# INSTRUCTIONS:
# 1. Copy this file to `.env` in the root directory.
# 2. Update the values with your actual secure credentials.
# 3. For backend-specific settings (like Django settings), you can maintain 
#    `backend/.env.production` directly, but many compose configurations
#    extract settings right from this root `.env`.
# ==============================================================================

# ----------------------------------------
# PostgreSQL Database Settings
# ----------------------------------------
# These variables configure the PostgreSQL database container.
DATABASE_NAME=mycrm_db
DATABASE_USER=mycrm_user
DATABASE_PASSWORD=your_secure_db_password_here
# Certain compose files (like docker-compose.production.yml) also check for DB_PASSWORD
DB_PASSWORD=your_secure_db_password_here

# ----------------------------------------
# Redis Settings
# ----------------------------------------
# Configure Redis access, specially important for production secure setups.
REDIS_PASSWORD=your_secure_redis_password_here

# ----------------------------------------
# Django application secrets
# ----------------------------------------
# Passed directly into the backend container by docker-compose.production.yml
SECRET_KEY=your_highly_secure_django_secret_key_here

# ----------------------------------------
# Monitoring Stack (Grafana / Prometheus)
# ----------------------------------------
# Set up secure logins for your Grafana dashboard.
GRAFANA_USER=admin
GRAFANA_PASSWORD=super_secure_grafana_admin_password

# ----------------------------------------
# Frontend / UI Configuration
# ----------------------------------------
# Configuration for the React/Next.js frontend container
NEXT_PUBLIC_API_URL=https://mycrm.faizanmalik.me/api
NEXT_PUBLIC_APP_URL=https://mycrm.faizanmalik.me
NEXT_PUBLIC_WS_URL=wss://mycrm.faizanmalik.me/ws
NODE_ENV=production

# ----------------------------------------
# Domain / Django host settings
# ----------------------------------------
# Portfolio stays on faizanmalik.me — CRM uses subdomain only
ALLOWED_HOSTS=mycrm.faizanmalik.me
CORS_ALLOWED_ORIGINS=https://mycrm.faizanmalik.me
CSRF_TRUSTED_ORIGINS=https://mycrm.faizanmalik.me